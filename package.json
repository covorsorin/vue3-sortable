{
  "name": "vue3-sortable",
  "version": "0.14.0",
  "description": "Vue 3 sortable lists",
  "type": "module",
  "files": [
    "dist",
    "web-types.json"
  ],
  "web-types": "./web-types.json",
  "exports": {
    ".": {
      "import": {
        "import": "./dist/vue3-sortable-lib.js",
        "require": "./dist/vue3-sortable-lib.umd.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build && npm run web-types",
    "web-types": "node scripts/generate-web-types.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-docgen-api": "^4.79.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CovorSorin/vue3-sortable.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "sortable",
    "draggable",
    "reordable",
    "list"
  ],
  "author": "Sorin Covor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CovorSorin/vue3-sortable/issues"
  },
  "homepage": "https://github.com/CovorSorin/vue3-sortable#readme"
}
